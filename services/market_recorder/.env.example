# ============================================================================
# Market Recorder - Environment Configuration
# ============================================================================
# Copy this file to .env and configure for your environment

# ---------------------------------------------------------------------------
# Database (TimescaleDB)
# ---------------------------------------------------------------------------
# Local development (docker-compose)
MARKET_RECORDER_DATABASE_URL=postgresql+asyncpg://synesthesia:synesthesia@localhost:5433/market_data

# Digital Ocean Managed Database (production)
# MARKET_RECORDER_DATABASE_URL=postgresql+asyncpg://user:password@host:25060/market_data?sslmode=require

# ---------------------------------------------------------------------------
# Binance WebSocket
# ---------------------------------------------------------------------------
# US users: wss://stream.binance.us:9443/ws
# International: wss://stream.binance.com:9443/ws
MARKET_RECORDER_BINANCE_WS_URL=wss://stream.binance.us:9443/ws

# Order book depth levels (5, 10, or 20)
MARKET_RECORDER_BINANCE_DEPTH_LEVELS=20

# Update speed (100 or 1000 ms)
MARKET_RECORDER_BINANCE_DEPTH_UPDATE_MS=100

# ---------------------------------------------------------------------------
# Streaming Configuration
# ---------------------------------------------------------------------------
# Default symbols to stream (comma-separated)
MARKET_RECORDER_DEFAULT_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT

# Maximum concurrent recordings
MARKET_RECORDER_MAX_CONCURRENT_RECORDINGS=10

# Batch insert settings for TimescaleDB efficiency
MARKET_RECORDER_BATCH_INSERT_SIZE=100
MARKET_RECORDER_BATCH_INSERT_INTERVAL_MS=500

# ---------------------------------------------------------------------------
# Signal Detection
# ---------------------------------------------------------------------------
# Candle interval for trend calculation (seconds)
MARKET_RECORDER_CANDLE_INTERVAL_SECONDS=30

# EMA period for bulls/bears ratio smoothing
MARKET_RECORDER_SIGNAL_EMA_PERIOD=30

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
MARKET_RECORDER_HOST=0.0.0.0
MARKET_RECORDER_PORT=8000
MARKET_RECORDER_DEBUG=false
MARKET_RECORDER_LOG_LEVEL=INFO

# CORS origins (comma-separated, or * for all)
MARKET_RECORDER_CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# Docker Compose Overrides
# ---------------------------------------------------------------------------
# Database password (used by docker-compose)
DB_PASSWORD=synesthesia

# Exposed ports
DB_PORT=5433
